# Copy to .env.local (web) or .env (scripts). Never commit real values.

# --- GitHub ---
# Personal access token, ONLY for local spikes (scripts/). Classic: read:user. Fine-grained: no repo permissions needed.
GITHUB_TOKEN=

# GitHub App (user authorization flow) — used by apps/web for real users.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional. The app's URL slug (github.com/apps/<slug>). When set, the dashboard offers to install
# the app with Metadata: read so private repositories you own are counted (ADR-0008).
GITHUB_APP_SLUG=

# --- Web ---
# Origin of this deployment, no trailing slash. Production: https://wrapyourgit.habibiahmada.dev
# Used for OAuth callbacks, canonical URLs, the sitemap and robots.txt.
APP_URL=http://localhost:3000
# 32-byte base64 key for encrypting OAuth tokens at rest: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# --- Database ---
# Local: `bun scripts/dev-db.ts` starts Postgres 16 (podman or docker) with these credentials.
DATABASE_URL=postgres://wyg:wyg@localhost:54329/wrapyourgit
