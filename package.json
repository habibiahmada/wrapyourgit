{
  "name": "wrapyourgit",
  "version": "0.1.0",
  "description": "Your GitHub year as an animated story: contributions, streaks, languages, projects and your developer archetype, with a soundtrack.",
  "keywords": [
    "github-wrapped",
    "github",
    "year-in-review",
    "wrapped",
    "github-stats",
    "contribution-graph",
    "developer-tools",
    "remotion",
    "nextjs",
    "storytelling"
  ],
  "homepage": "https://wrapyourgit.habibiahmada.dev",
  "bugs": {
    "url": "https://github.com/habibiahmada/wrapyourgit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habibiahmada/wrapyourgit.git"
  },
  "license": "MIT",
  "author": {
    "name": "Habibi Ahmad Aziz",
    "url": "https://habibiahmada.dev"
  },
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "dev": "bun run --filter @wyg/web dev",
    "build": "bun run --filter @wyg/web build",
    "studio": "bun run --filter @wyg/video studio",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "typescript": "^7"
  }
}
